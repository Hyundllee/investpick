{
  "name": "investpick",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KODEX 오늘의 투자픽 - React + TypeScript + SCSS + Webpack",
  "scripts": {
    "dev": "node ./node_modules/webpack-cli/bin/cli.js serve --mode development",
    "build": "node ./node_modules/webpack-cli/bin/cli.js --mode production",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "scss:check": "node ./node_modules/sass/sass.js src/styles/common/components/investpick/index.scss .scss-check.css --no-source-map"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-svg": "^16.3.0",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "sass": "^1.80.7",
    "sass-loader": "^16.0.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 Firefox versions"
  ]
}
